{
  "name": "dsh-mcp-flapi",
  "version": "1.0.0",
  "description": "DSH bundle: register FilmLight's official FLAPI MCP Assistant (flapi-dev-mcp) so any DSH instance can write and run Baselight / Daylight FLAPI scripts. 把 FilmLight 官方的 FLAPI MCP 接进 DeepSeek Harness。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "filmlight",
    "baselight",
    "daylight",
    "flapi",
    "colour",
    "grading"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./setup": "./lib/setup.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-mcp-flapi-setup": "lib/setup.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.5 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.5 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "author": "wangbodbs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangbodbs/dsh-plugins.git",
    "directory": "packages/dsh-mcp-flapi"
  },
  "homepage": "https://github.com/wangbodbs/dsh-plugins/tree/main/packages/dsh-mcp-flapi#readme",
  "bugs": {
    "url": "https://github.com/wangbodbs/dsh-plugins/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
