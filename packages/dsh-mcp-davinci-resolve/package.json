{
  "name": "dsh-mcp-davinci-resolve",
  "version": "1.0.0",
  "description": "DSH bundle: register Blackmagic DaVinci Resolve 21.1+'s built-in MCP server, so any DSH instance (CLI or desktop) can drive Resolve. 把达芬奇内置的 MCP 接进 DeepSeek Harness。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "davinci-resolve",
    "blackmagic",
    "colour",
    "grading"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.5 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.5 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "author": "wangbodbs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangbodbs/dsh-plugins.git",
    "directory": "packages/dsh-mcp-davinci-resolve"
  },
  "homepage": "https://github.com/wangbodbs/dsh-plugins/tree/main/packages/dsh-mcp-davinci-resolve#readme",
  "bugs": {
    "url": "https://github.com/wangbodbs/dsh-plugins/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
